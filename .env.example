# Leaderboard is OPTIONAL. Leave these unset and the game runs fully with the
# global board simply disabled (local best score still works).
# Copy to `.env` and fill in to enable the Supabase top-100 board.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase table (single table):
#   create table scores (
#     id bigint generated always as identity primary key,
#     name text not null,
#     score int not null,
#     wave int not null,
#     ts timestamptz default now()
#   );
#   alter table scores enable row level security;
#   create policy "read all"  on scores for select using (true);
#   create policy "insert all" on scores for insert with check (true);
